# =============================================================================
# Claimora — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# The .env file is git-ignored and must NEVER be committed.
# =============================================================================

# --- PostgreSQL / Supabase Connection ---
DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# --- Admin Seed Account (created on first startup if no ADMIN exists) ---
ADMIN_EMAIL=admin@claimora.internal
ADMIN_PASSWORD=AdminPass123!
ADMIN_NAME=Claimora Administrator
